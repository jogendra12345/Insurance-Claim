<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="Definitions_health_claim_routing" name="health-claim-routing" namespace="http://camunda.org/schema/1.0/dmn" exporter="ClaimFlow AI" exporterVersion="1.0">
  <decision id="health-claim-routing-decision" name="Health Claim Routing Decision">
    <extensionElements>
      <biodi:bounds xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" x="160" y="90" width="180" height="80" />
    </extensionElements>
    <decisionTable id="DecisionTable_health_claim_routing" hitPolicy="FIRST">
      <input id="Input_fraudIndicatorCount" label="Fraud Indicators">
        <inputExpression id="InputExpression_fraudIndicatorCount" typeRef="number">
          <text>fraudIndicatorCount</text>
        </inputExpression>
      </input>
      <input id="Input_riskScore" label="Risk Score">
        <inputExpression id="InputExpression_riskScore" typeRef="number">
          <text>riskScore</text>
        </inputExpression>
      </input>
      <input id="Input_claimAmount" label="Claim Amount">
        <inputExpression id="InputExpression_claimAmount" typeRef="number">
          <text>claimAmount</text>
        </inputExpression>
      </input>
      <input id="Input_daysSincePolicyEffective" label="Days Since Policy Effective">
        <inputExpression id="InputExpression_daysSincePolicyEffective" typeRef="number">
          <text>daysSincePolicyEffective</text>
        </inputExpression>
      </input>
      <input id="Input_claimantClaimCountLast12Months" label="Claimant Claim Count (12mo)">
        <inputExpression id="InputExpression_claimantClaimCountLast12Months" typeRef="number">
          <text>claimantClaimCountLast12Months</text>
        </inputExpression>
      </input>
      <output id="Output_assignedRole" label="Assigned Role" name="assignedRole" typeRef="string" />
      <!-- High-dollar exposure takes priority over everything else: legal
           needs to see this claim regardless of whether fraud/risk also
           flagged it (a FIRST hit policy can only pick one row, and
           high-dollar legal exposure is the more encompassing concern). -->
      <rule id="Rule_legal">
        <inputEntry id="InputEntry_legal_fraud">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_legal_risk">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_legal_amount">
          <text>&gt; 50000</text>
        </inputEntry>
        <inputEntry id="InputEntry_legal_days">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_legal_claimCount">
          <text></text>
        </inputEntry>
        <outputEntry id="OutputEntry_legal">
          <text>"legal"</text>
        </outputEntry>
      </rule>
      <rule id="Rule_investigator_fraud">
        <inputEntry id="InputEntry_investigatorFraud_fraud">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="InputEntry_investigatorFraud_risk">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_investigatorFraud_amount">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_investigatorFraud_days">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_investigatorFraud_claimCount">
          <text></text>
        </inputEntry>
        <outputEntry id="OutputEntry_investigatorFraud">
          <text>"investigator"</text>
        </outputEntry>
      </rule>
      <!-- Red flag: loss reported suspiciously close to the policy's
           effective date. -->
      <rule id="Rule_investigator_earlyClaim">
        <inputEntry id="InputEntry_investigatorEarly_fraud">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_investigatorEarly_risk">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_investigatorEarly_amount">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_investigatorEarly_days">
          <text>&lt;= 14</text>
        </inputEntry>
        <inputEntry id="InputEntry_investigatorEarly_claimCount">
          <text></text>
        </inputEntry>
        <outputEntry id="OutputEntry_investigatorEarly">
          <text>"investigator"</text>
        </outputEntry>
      </rule>
      <!-- Red flag: claimant has filed several claims in the trailing 12
           months. -->
      <rule id="Rule_investigator_frequency">
        <inputEntry id="InputEntry_investigatorFreq_fraud">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_investigatorFreq_risk">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_investigatorFreq_amount">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_investigatorFreq_days">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_investigatorFreq_claimCount">
          <text>&gt;= 3</text>
        </inputEntry>
        <outputEntry id="OutputEntry_investigatorFreq">
          <text>"investigator"</text>
        </outputEntry>
      </rule>
      <rule id="Rule_adjuster_risk">
        <inputEntry id="InputEntry_adjusterRisk_fraud">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_adjusterRisk_risk">
          <text>&gt;= 40</text>
        </inputEntry>
        <inputEntry id="InputEntry_adjusterRisk_amount">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_adjusterRisk_days">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_adjusterRisk_claimCount">
          <text></text>
        </inputEntry>
        <outputEntry id="OutputEntry_adjusterRisk">
          <text>"adjuster"</text>
        </outputEntry>
      </rule>
      <rule id="Rule_adjuster_amount">
        <inputEntry id="InputEntry_adjusterAmount_fraud">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_adjusterAmount_risk">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_adjusterAmount_amount">
          <text>&gt; 5000</text>
        </inputEntry>
        <inputEntry id="InputEntry_adjusterAmount_days">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_adjusterAmount_claimCount">
          <text></text>
        </inputEntry>
        <outputEntry id="OutputEntry_adjusterAmount">
          <text>"adjuster"</text>
        </outputEntry>
      </rule>
      <!-- Catch-all: nothing above matched, so this is a low-risk/low-value
           claim. Still routes to a real specialist (adjuster, the lightest-
           weight reviewer) rather than an "auto" pseudo-role — every claim
           gets a human review from one of the three real roles, no bypass. -->
      <rule id="Rule_adjuster_default">
        <inputEntry id="InputEntry_adjusterDefault_fraud">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_adjusterDefault_risk">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_adjusterDefault_amount">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_adjusterDefault_days">
          <text></text>
        </inputEntry>
        <inputEntry id="InputEntry_adjusterDefault_claimCount">
          <text></text>
        </inputEntry>
        <outputEntry id="OutputEntry_adjusterDefault">
          <text>"adjuster"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_health_claim_routing">
      <dmndi:DMNShape id="DMNShape_health_claim_routing_decision" dmnElementRef="health-claim-routing-decision">
        <dc:Bounds x="160" y="90" width="180" height="80" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
