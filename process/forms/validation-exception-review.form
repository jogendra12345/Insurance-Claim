{
  "components": [
    {
      "text": "## Validation Exception Review\n\nThis claim failed automated validation.\n\nPolicy number submitted: **{{policyNumber}}** · Claim type: **{{claimType}}** · Amount: **{{claimAmount}}**\n\nCheck the Process/History tab for the exact `validated` audit entry (missing fields / policy match failure / duplicate) before deciding. There's no way to change the policy number here — Approve continues the claim exactly as submitted.",
      "type": "text",
      "id": "IntroText"
    },
    {
      "text": "⚠️ **Duplicate claim** — another claim (**{{duplicateClaimId}}**) against this same policy hasn't reached a final decision yet.",
      "type": "text",
      "id": "DuplicateClaimWarning",
      "conditional": {
        "hide": "=duplicatePendingClaim = false"
      }
    },
    {
      "text": "⚠️ **Unrecognized claimant** — {{claimantName}} ({{claimantEmail}}) doesn't match the policyholder or any listed dependent on this policy. Verify this is a legitimate claimant (e.g. a dependent not yet on file) before resolving.",
      "type": "text",
      "id": "UnauthorizedClaimantWarning",
      "conditional": {
        "hide": "=authorizedClaimant = true"
      }
    },
    {
      "text": "⚠️ **No policy matched** — nothing on file matches the submitted policy number for this claim's incident date. Approving continues the claim with no policy attached — no coverage, active-status, or incident-date check will ever run for it. Only approve if you have a specific reason to believe this is a legitimate claim despite the mismatch.",
      "type": "text",
      "id": "NoPolicyMatchedWarning",
      "conditional": {
        "hide": "=policyId != null"
      }
    },
    {
      "label": "Action",
      "type": "radio",
      "id": "ResolutionActionField",
      "key": "resolutionAction",
      "validate": {
        "required": true
      },
      "values": [
        { "label": "Approve — continue with this claim as submitted", "value": "resolve" },
        { "label": "Reject claim", "value": "reject" }
      ]
    },
    {
      "label": "Rejection reason",
      "type": "textarea",
      "id": "DenialReasonField",
      "key": "denialReason",
      "validate": {
        "required": true
      },
      "conditional": {
        "hide": "=resolutionAction != \"reject\""
      }
    }
  ],
  "type": "default",
  "id": "ValidationExceptionReviewForm",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 17
}
