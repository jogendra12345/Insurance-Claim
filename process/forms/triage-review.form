{
  "components": [
    {
      "text": "## Triage Review",
      "type": "text",
      "id": "IntroText"
    },
    {
      "label": "Policy & claim details",
      "type": "group",
      "id": "PolicyClaimDetailsGroup",
      "showOutline": true,
      "components": [
        {
          "text": "**Policy:** {{policyNumber}} — {{policyholderName}}\n**Coverage amount:** {{coverageAmount}}\n\n**Claimant:** {{claimantName}} ({{claimantEmail}})\n**Claim type:** {{claimType}}\n**Incident date:** {{incidentDate}}\n**What happened:** {{incidentDescription}}\n\n**Diagnosis code:** {{diagnosisCode}}\n**Procedure code:** {{procedureCode}}\n**Service date(s):** {{serviceDateFrom}} to {{serviceDateTo}}\n**Provider:** {{providerFacilityName}} (NPI {{providerNpi}})\n\n**Requested claim amount:** {{claimAmount}}\n**Total billed amount:** {{totalBilledAmount}}\n**Coordination of benefits:** {{coordinationOfBenefits}}",
          "type": "text",
          "id": "PolicyClaimDetailsText"
        }
      ]
    },
    {
      "label": "AI generated summary",
      "type": "group",
      "id": "AiSummaryGroup",
      "showOutline": true,
      "components": [
        {
          "text": "{{caseSummary}}\n\n**Risk score:** {{riskScore}} / 100\n**Risk reasoning:** {{riskReasoning}}\n**Fraud indicators flagged:** {{fraudIndicatorCount}}\n**AI-suggested routing:** {{assignedRole}}",
          "type": "text",
          "id": "AiSummaryText"
        }
      ]
    },
    {
      "label": "Documents",
      "type": "group",
      "id": "DocumentsGroup",
      "showOutline": true,
      "components": [
        {
          "text": "{{= if count(documents) = 0 then \"No documents attached.\" else string join(for d in documents return \"- [\" + d.name + \"](\" + d.url + \")\", \"\\n\")}}",
          "type": "text",
          "id": "DocumentsText"
        },
        {
          "text": "{{= if count(documents) >= 1 and documents[1].dataUri != null then documents[1].name else \"\"}}",
          "type": "text",
          "id": "DocumentImage1Caption",
          "conditional": {
            "hide": "=count(documents) < 1 or documents[1].dataUri = null"
          }
        },
        {
          "source": "=if count(documents) >= 1 then documents[1].dataUri else null",
          "alt": "Uploaded document image",
          "type": "image",
          "id": "DocumentImage1",
          "conditional": {
            "hide": "=count(documents) < 1 or documents[1].dataUri = null"
          }
        },
        {
          "text": "{{= if count(documents) >= 2 and documents[2].dataUri != null then documents[2].name else \"\"}}",
          "type": "text",
          "id": "DocumentImage2Caption",
          "conditional": {
            "hide": "=count(documents) < 2 or documents[2].dataUri = null"
          }
        },
        {
          "source": "=if count(documents) >= 2 then documents[2].dataUri else null",
          "alt": "Uploaded document image",
          "type": "image",
          "id": "DocumentImage2",
          "conditional": {
            "hide": "=count(documents) < 2 or documents[2].dataUri = null"
          }
        },
        {
          "text": "{{= if count(documents) >= 3 and documents[3].dataUri != null then documents[3].name else \"\"}}",
          "type": "text",
          "id": "DocumentImage3Caption",
          "conditional": {
            "hide": "=count(documents) < 3 or documents[3].dataUri = null"
          }
        },
        {
          "source": "=if count(documents) >= 3 then documents[3].dataUri else null",
          "alt": "Uploaded document image",
          "type": "image",
          "id": "DocumentImage3",
          "conditional": {
            "hide": "=count(documents) < 3 or documents[3].dataUri = null"
          }
        }
      ]
    },
    {
      "label": "Decision",
      "type": "group",
      "id": "DecisionGroup",
      "showOutline": true,
      "components": [
        {
          "label": "Action",
          "type": "radio",
          "id": "TriageActionField",
          "key": "triageAction",
          "validate": {
            "required": true
          },
          "values": [
            { "label": "Route for specialist review", "value": "review" },
            { "label": "Reject claim", "value": "reject" }
          ]
        },
        {
          "label": "Confirmed role",
          "type": "radio",
          "id": "ConfirmedRoleField",
          "key": "confirmedRole",
          "validate": {
            "required": true
          },
          "conditional": {
            "hide": "=triageAction = \"reject\""
          },
          "readonly": "=triageAction != \"review\"",
          "values": [
            { "label": "Adjuster", "value": "adjuster" },
            { "label": "Investigator", "value": "investigator" },
            { "label": "Legal", "value": "legal" }
          ]
        },
        {
          "label": "Rejection reason",
          "type": "textarea",
          "id": "DenialReasonField",
          "key": "denialReason",
          "validate": {
            "required": true
          },
          "conditional": {
            "hide": "=triageAction != \"reject\""
          }
        }
      ]
    }
  ],
  "type": "default",
  "id": "TriageReviewForm",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 17
}
