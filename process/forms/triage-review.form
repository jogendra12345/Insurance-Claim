{
  "components": [
    {
      "text": "## Triage Review\n\nThe AI suggested routing this claim to: **{{assignedRole}}**\n\nRisk score: **{{riskScore}}** · Fraud indicators: **{{fraudIndicatorCount}}**\n\n{{caseSummary}}",
      "type": "text",
      "id": "IntroText"
    },
    {
      "label": "Action",
      "type": "radio",
      "id": "TriageActionField",
      "key": "triageAction",
      "validate": {
        "required": true
      },
      "values": [
        { "label": "Route for specialist review", "value": "review" },
        { "label": "Reject claim", "value": "reject" }
      ]
    },
    {
      "label": "Confirmed role",
      "type": "radio",
      "id": "ConfirmedRoleField",
      "key": "confirmedRole",
      "validate": {
        "required": true
      },
      "conditional": {
        "hide": "=triageAction = \"reject\""
      },
      "disabled": "=triageAction != \"review\"",
      "values": [
        { "label": "Adjuster", "value": "adjuster" },
        { "label": "Investigator", "value": "investigator" },
        { "label": "Legal", "value": "legal" }
      ]
    },
    {
      "label": "Rejection reason",
      "type": "textarea",
      "id": "DenialReasonField",
      "key": "denialReason",
      "validate": {
        "required": true
      },
      "conditional": {
        "hide": "=triageAction != \"reject\""
      }
    }
  ],
  "type": "default",
  "id": "TriageReviewForm",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 17
}
