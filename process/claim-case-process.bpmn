<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_claim_case_process" targetNamespace="http://camunda.org/schema/1.0/bpmn" exporter="ClaimFlow AI" exporterVersion="1.0">
  <bpmn:process id="claim-case-process" name="Claim Case Process" isExecutable="true">

    <bpmn:startEvent id="StartEvent_ClaimSubmitted" name="Claim Submitted">
      <bpmn:outgoing>Flow_ToValidateClaim</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_ValidateClaim" name="validate-claim">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-claim" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidateClaim</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidationGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_ValidationPassed" name="Validation Passed?" default="Flow_ValidationPassed_Yes">
      <bpmn:incoming>Flow_ToValidationGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidationPassed_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidationPassed_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ValidationExceptionReview" name="Validation Exception Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="triage-team" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidationPassed_No</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCaptureValidationException</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_CaptureValidationException" name="capture-validation-exception">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="capture-validation-exception" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCaptureValidationException</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidationFailed</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_ValidationFailed" name="Validation Failed">
      <bpmn:incoming>Flow_ToValidationFailed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_ExtractEvidence" name="extract-evidence">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="extract-evidence" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidationPassed_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDetectFraud</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_DetectFraudIndicators" name="detect-fraud-indicators">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="detect-fraud-indicators" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDetectFraud</bpmn:incoming>
      <bpmn:outgoing>Flow_ToScoreRisk</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ScoreRisk" name="score-risk">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="score-risk" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToScoreRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRoutingDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_RoutingDecision" name="Evaluate Routing Decision">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="=insuranceType + &#34;-claim-routing-decision&#34;" resultVariable="assignedRole" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRoutingDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTriageGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:serviceTask id="Task_CaptureRoutingDecision" name="capture-routing-decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="capture-routing-decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCaptureRoutingDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTriageGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- No auto-approval bypass here: every claim passes through Triage Review
         so a human always confirms the AI-suggested `assignedRole` before any
         role-specific review, per CLAUDE.md's "a human always confirms the
         AI's suggested routing" guarantee. `assignedRole` (from the DMN
         decision) is shown to the triage reviewer as a suggestion; the
         confirmed role a human actually sets is `confirmedRole`. -->
    <bpmn:userTask id="Task_TriageReview" name="Triage Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="triage-team" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTriageGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCaptureTriageReview</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_CaptureTriageReview" name="capture-triage-review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="capture-triage-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCaptureTriageReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRoleGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_RouteByConfirmedRole" name="Route by Confirmed Role" default="Flow_Role_Adjuster">
      <bpmn:incoming>Flow_ToRoleGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Role_Adjuster</bpmn:outgoing>
      <bpmn:outgoing>Flow_Role_Investigator</bpmn:outgoing>
      <bpmn:outgoing>Flow_Role_Legal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_AdjusterReview" name="Adjuster Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="adjusters" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Role_Adjuster</bpmn:incoming>
      <bpmn:outgoing>Flow_Adjuster_ToDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_InvestigatorReview" name="Investigator Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="investigators" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Role_Investigator</bpmn:incoming>
      <bpmn:outgoing>Flow_Investigator_ToDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_LegalReview" name="Legal Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="legal-reviewers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Role_Legal</bpmn:incoming>
      <bpmn:outgoing>Flow_Legal_ToDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_CaptureReviewDecision" name="capture-review-decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="capture-review-decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Adjuster_ToDecision</bpmn:incoming>
      <bpmn:incoming>Flow_Investigator_ToDecision</bpmn:incoming>
      <bpmn:incoming>Flow_Legal_ToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDecisionGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision" default="Flow_Decision_Approve">
      <bpmn:incoming>Flow_ToDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_Deny</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_MoreInfo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_AwaitingMoreInfo" name="Awaiting More Information">
      <bpmn:incoming>Flow_Decision_MoreInfo</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_NeedsSecondSignoff" name="Needs Second Sign-off?" default="Flow_Signoff_No">
      <bpmn:incoming>Flow_Decision_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_Signoff_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Signoff_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_SupervisorSignoff" name="Supervisor Sign-off">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="supervisors" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Signoff_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCaptureSignoff</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_CaptureSignoff" name="capture-signoff">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="capture-signoff" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCaptureSignoff</bpmn:incoming>
      <bpmn:outgoing>Flow_Signoff_ToSettlement</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_TriggerSettlement" name="trigger-settlement">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="trigger-settlement" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Signoff_No</bpmn:incoming>
      <bpmn:incoming>Flow_Signoff_ToSettlement</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotifyApproved</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_NotifyClaimant_Approved" name="notify-claimant">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-claimant" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotifyApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCloseApproved</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_CloseCase_Approved" name="close-case">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="close-case" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCloseApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToClaimApproved</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_ClaimApproved" name="Claim Approved">
      <bpmn:incoming>Flow_ToClaimApproved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_DraftDenialLetter" name="draft-denial-letter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="draft-denial-letter" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Decision_Deny</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotifyDenied</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_NotifyClaimant_Denied" name="notify-claimant">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-claimant" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotifyDenied</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCloseDenied</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_CloseCase_Denied" name="close-case">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="close-case" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCloseDenied</bpmn:incoming>
      <bpmn:outgoing>Flow_ToClaimDenied</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_ClaimDenied" name="Claim Denied">
      <bpmn:incoming>Flow_ToClaimDenied</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToValidateClaim" sourceRef="StartEvent_ClaimSubmitted" targetRef="Task_ValidateClaim" />
    <bpmn:sequenceFlow id="Flow_ToValidationGateway" sourceRef="Task_ValidateClaim" targetRef="Gateway_ValidationPassed" />
    <bpmn:sequenceFlow id="Flow_ValidationPassed_Yes" name="Yes" sourceRef="Gateway_ValidationPassed" targetRef="Task_ExtractEvidence" />
    <bpmn:sequenceFlow id="Flow_ValidationPassed_No" name="No" sourceRef="Gateway_ValidationPassed" targetRef="Task_ValidationExceptionReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=validationPassed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToCaptureValidationException" sourceRef="Task_ValidationExceptionReview" targetRef="Task_CaptureValidationException" />
    <bpmn:sequenceFlow id="Flow_ToValidationFailed" sourceRef="Task_CaptureValidationException" targetRef="EndEvent_ValidationFailed" />
    <bpmn:sequenceFlow id="Flow_ToDetectFraud" sourceRef="Task_ExtractEvidence" targetRef="Task_DetectFraudIndicators" />
    <bpmn:sequenceFlow id="Flow_ToScoreRisk" sourceRef="Task_DetectFraudIndicators" targetRef="Task_ScoreRisk" />
    <bpmn:sequenceFlow id="Flow_ToRoutingDecision" sourceRef="Task_ScoreRisk" targetRef="Task_RoutingDecision" />
    <bpmn:sequenceFlow id="Flow_ToCaptureRoutingDecision" sourceRef="Task_RoutingDecision" targetRef="Task_CaptureRoutingDecision" />
    <bpmn:sequenceFlow id="Flow_ToTriageGateway" sourceRef="Task_CaptureRoutingDecision" targetRef="Task_TriageReview" />
    <bpmn:sequenceFlow id="Flow_ToCaptureTriageReview" sourceRef="Task_TriageReview" targetRef="Task_CaptureTriageReview" />
    <bpmn:sequenceFlow id="Flow_ToRoleGateway" sourceRef="Task_CaptureTriageReview" targetRef="Gateway_RouteByConfirmedRole" />
    <bpmn:sequenceFlow id="Flow_Role_Adjuster" name="adjuster" sourceRef="Gateway_RouteByConfirmedRole" targetRef="Task_AdjusterReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=confirmedRole = "adjuster"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Role_Investigator" name="investigator" sourceRef="Gateway_RouteByConfirmedRole" targetRef="Task_InvestigatorReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=confirmedRole = "investigator"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Role_Legal" name="legal" sourceRef="Gateway_RouteByConfirmedRole" targetRef="Task_LegalReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=confirmedRole = "legal"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Adjuster_ToDecision" sourceRef="Task_AdjusterReview" targetRef="Task_CaptureReviewDecision" />
    <bpmn:sequenceFlow id="Flow_Investigator_ToDecision" sourceRef="Task_InvestigatorReview" targetRef="Task_CaptureReviewDecision" />
    <bpmn:sequenceFlow id="Flow_Legal_ToDecision" sourceRef="Task_LegalReview" targetRef="Task_CaptureReviewDecision" />
    <bpmn:sequenceFlow id="Flow_ToDecisionGateway" sourceRef="Task_CaptureReviewDecision" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Decision_Approve" name="approve" sourceRef="Gateway_Decision" targetRef="Gateway_NeedsSecondSignoff" />
    <bpmn:sequenceFlow id="Flow_Decision_Deny" name="deny" sourceRef="Gateway_Decision" targetRef="Task_DraftDenialLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "deny"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Decision_MoreInfo" name="more info" sourceRef="Gateway_Decision" targetRef="EndEvent_AwaitingMoreInfo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "moreInfo"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Signoff_Yes" name="yes" sourceRef="Gateway_NeedsSecondSignoff" targetRef="Task_SupervisorSignoff">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=claimAmount &gt; 50000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Signoff_No" name="no" sourceRef="Gateway_NeedsSecondSignoff" targetRef="Task_TriggerSettlement" />
    <bpmn:sequenceFlow id="Flow_ToCaptureSignoff" sourceRef="Task_SupervisorSignoff" targetRef="Task_CaptureSignoff" />
    <bpmn:sequenceFlow id="Flow_Signoff_ToSettlement" sourceRef="Task_CaptureSignoff" targetRef="Task_TriggerSettlement" />
    <bpmn:sequenceFlow id="Flow_ToNotifyApproved" sourceRef="Task_TriggerSettlement" targetRef="Task_NotifyClaimant_Approved" />
    <bpmn:sequenceFlow id="Flow_ToCloseApproved" sourceRef="Task_NotifyClaimant_Approved" targetRef="Task_CloseCase_Approved" />
    <bpmn:sequenceFlow id="Flow_ToClaimApproved" sourceRef="Task_CloseCase_Approved" targetRef="EndEvent_ClaimApproved" />
    <bpmn:sequenceFlow id="Flow_ToNotifyDenied" sourceRef="Task_DraftDenialLetter" targetRef="Task_NotifyClaimant_Denied" />
    <bpmn:sequenceFlow id="Flow_ToCloseDenied" sourceRef="Task_NotifyClaimant_Denied" targetRef="Task_CloseCase_Denied" />
    <bpmn:sequenceFlow id="Flow_ToClaimDenied" sourceRef="Task_CloseCase_Denied" targetRef="EndEvent_ClaimDenied" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="claim-case-process">

      <bpmndi:BPMNShape id="StartEvent_ClaimSubmitted_di" bpmnElement="StartEvent_ClaimSubmitted">
        <dc:Bounds x="152" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateClaim_di" bpmnElement="Task_ValidateClaim">
        <dc:Bounds x="240" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ValidationPassed_di" bpmnElement="Gateway_ValidationPassed" isMarkerVisible="true">
        <dc:Bounds x="395" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidationExceptionReview_di" bpmnElement="Task_ValidationExceptionReview">
        <dc:Bounds x="370" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ValidationFailed_di" bpmnElement="EndEvent_ValidationFailed">
        <dc:Bounds x="532" y="362" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExtractEvidence_di" bpmnElement="Task_ExtractEvidence">
        <dc:Bounds x="500" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DetectFraudIndicators_di" bpmnElement="Task_DetectFraudIndicators">
        <dc:Bounds x="660" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScoreRisk_di" bpmnElement="Task_ScoreRisk">
        <dc:Bounds x="820" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RoutingDecision_di" bpmnElement="Task_RoutingDecision">
        <dc:Bounds x="980" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TriageReview_di" bpmnElement="Task_TriageReview">
        <dc:Bounds x="1110" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RouteByConfirmedRole_di" bpmnElement="Gateway_RouteByConfirmedRole" isMarkerVisible="true">
        <dc:Bounds x="1265" y="355" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AdjusterReview_di" bpmnElement="Task_AdjusterReview">
        <dc:Bounds x="1370" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InvestigatorReview_di" bpmnElement="Task_InvestigatorReview">
        <dc:Bounds x="1370" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LegalReview_di" bpmnElement="Task_LegalReview">
        <dc:Bounds x="1370" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="1525" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_AwaitingMoreInfo_di" bpmnElement="EndEvent_AwaitingMoreInfo">
        <dc:Bounds x="1682" y="622" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_NeedsSecondSignoff_di" bpmnElement="Gateway_NeedsSecondSignoff" isMarkerVisible="true">
        <dc:Bounds x="1675" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SupervisorSignoff_di" bpmnElement="Task_SupervisorSignoff">
        <dc:Bounds x="1650" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TriggerSettlement_di" bpmnElement="Task_TriggerSettlement">
        <dc:Bounds x="1820" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyClaimant_Approved_di" bpmnElement="Task_NotifyClaimant_Approved">
        <dc:Bounds x="1970" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CloseCase_Approved_di" bpmnElement="Task_CloseCase_Approved">
        <dc:Bounds x="2120" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ClaimApproved_di" bpmnElement="EndEvent_ClaimApproved">
        <dc:Bounds x="2282" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DraftDenialLetter_di" bpmnElement="Task_DraftDenialLetter">
        <dc:Bounds x="1650" y="500" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyClaimant_Denied_di" bpmnElement="Task_NotifyClaimant_Denied">
        <dc:Bounds x="1800" y="500" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CloseCase_Denied_di" bpmnElement="Task_CloseCase_Denied">
        <dc:Bounds x="1950" y="500" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ClaimDenied_di" bpmnElement="EndEvent_ClaimDenied">
        <dc:Bounds x="2102" y="522" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- capture-* shapes placed in the open row below the main flow —
           purely cosmetic; not laid out inline to avoid reflowing every
           downstream shape's coordinates. Re-layout in Camunda Modeler if a
           cleaner diagram is wanted; execution semantics don't depend on it. -->
      <bpmndi:BPMNShape id="Task_CaptureValidationException_di" bpmnElement="Task_CaptureValidationException">
        <dc:Bounds x="420" y="750" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CaptureRoutingDecision_di" bpmnElement="Task_CaptureRoutingDecision">
        <dc:Bounds x="980" y="750" width="100" height="80" />
