# Camunda local runtime data (Docker volume mount) — regenerated on `docker compose up`
camunda-docker/camunda-data/*
!camunda-docker/camunda-data/.gitkeep

# Optional JDBC driver jars
camunda-docker/driver-lib/*
!camunda-docker/driver-lib/.gitkeep

# Environment & secrets — reproducible by re-downloading the release archive; never commit real secrets here
camunda-docker/.env
camunda-docker/connector-secrets.txt

# App Postgres env
.env

# .env.example templates are no longer tracked — required vars are listed
# directly in RUNNING-LOCALLY.md instead.
.env.example
.env.local.example

# OS/editor cruft
.DS_Store
Thumbs.db

# Node dependencies / build output
node_modules/
.next/
dist/
*.tsbuildinfo
frontend/portal/.env.local
backend/api/.env
