# Same Postgres this repo's root docker-compose.yaml starts.
DATABASE_URL=postgresql://claimflow:claimflow@localhost:5432/claimflow

# Local Zeebe gRPC gateway (camunda-docker's lightweight stack). No auth —
# that stack runs its API unprotected (no Identity/Keycloak), see
# .claude/specs/generic/process-orchestration-kickoff.md.
ZEEBE_GRPC_ADDRESS=grpc://localhost:26500
CAMUNDA_AUTH_STRATEGY=NONE

# Gemini API (Google Generative Language) — used by extract-evidence,
# detect-fraud-indicators, score-risk, draft-denial-letter.
GEMINI_API_KEY=
# Pinned: "gemini-flash-latest" (-> gemini-3.7-flash) was returning transient
# 503s under high demand; 3.6-flash confirmed working.
GEMINI_MODEL=gemini-3.6-flash

# Resend (resend.com) — used by notify-claimant for real email delivery.
# Free-tier sandbox: without a verified domain, Resend only delivers to the
# address the account was signed up with, from the shared sandbox sender
# onboarding@resend.dev.
RESEND_API_KEY=
