# Same Postgres this repo's root docker-compose.yaml starts — see .env.example
# there. Duplicated here (rather than sharing one file) since backend/api is its
# own package with its own working directory.
DATABASE_URL=postgresql://claimflow:claimflow@localhost:5432/claimflow
PORT=4000
# Origin allowed to call this API — frontend/portal's dev server.
CORS_ORIGIN=http://localhost:3000
