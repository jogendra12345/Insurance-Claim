# Same Postgres this repo's root docker-compose.yaml starts — see .env.example
# there. Duplicated here (rather than sharing one file) since backend/api is its
# own package with its own working directory.
DATABASE_URL=postgresql://claimflow:claimflow@localhost:5432/claimflow
PORT=4000
# Origin allowed to call this API — frontend/portal's dev server.
CORS_ORIGIN=http://localhost:3000

# Same MinIO the root docker-compose.yaml starts — see .env.example there.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=claimflow
MINIO_ROOT_PASSWORD=claimflow123
MINIO_BUCKET=claim-documents

# Local Zeebe gRPC gateway (camunda-docker's lightweight stack). No auth —
# that stack runs its API unprotected (no Identity/Keycloak), see
# .claude/specs/generic/process-orchestration-kickoff.md.
ZEEBE_GRPC_ADDRESS=grpc://localhost:26500
CAMUNDA_AUTH_STRATEGY=NONE
